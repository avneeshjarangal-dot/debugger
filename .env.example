# Core integrations
GITHUB_TOKEN=your_github_pat_here
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=your-app
MONGO_DB=log
MONGO_COLLECTION=logs
REPO_FULL_NAME=owner/repo

# LLM providers
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional model overrides
GEMINI_MODEL=gemini-3-flash-preview
OPENAI_MODEL=gpt-4.1-mini
OPENROUTER_MODEL=openai/gpt-4.1-mini
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter metadata (optional)
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_APP_NAME=Proctor Debugger

# Local storage paths (optional)
CHROMA_DIR=./debugger_chroma
CLONE_BASE_DIR=./debugger_repos

# Runtime flags
ALLOW_EXTERNAL_AI=true
ALLOW_FRONTEND_SECRETS=false
